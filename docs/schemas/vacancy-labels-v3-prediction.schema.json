{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vacancy-labels-v3 machine prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_uid",
    "source_hash",
    "labeler",
    "variant",
    "status",
    "role_label",
    "relevance",
    "gate_outcome",
    "gate_reasons",
    "tags"
  ],
  "properties": {
    "schema": {
      "const": "vacancy-labels-v3-prediction"
    },
    "job_uid": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "labeler": {
      "type": "string",
      "pattern": "^(?:rules|llm|embedding):\\S+$"
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "labeled",
        "rules_only",
        "gated",
        "error"
      ]
    },
    "rubric_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "rubric_status": {
      "enum": [
        "confirmed",
        "proposed",
        null
      ]
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "aggregation_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "role_label": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relevance": {
      "enum": [
        0,
        1,
        2,
        3,
        null
      ]
    },
    "gate_outcome": {
      "enum": [
        "eligible",
        "ineligible",
        "unknown",
        null
      ]
    },
    "gate_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "hiring_region_restricted",
          "office_outside_sp",
          "other_language_required",
          "vacancy_closed",
          "work_authorization_required"
        ]
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hiring_eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "evidence"
          ],
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "open_to_brazil",
                "restricted_elsewhere",
                "unspecified"
              ]
            },
            "evidence": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "basis": {
              "enum": [
                "explicit",
                "implied"
              ]
            }
          }
        },
        "work_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "evidence"
          ],
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "remote",
                "office_sao_paulo",
                "office_elsewhere",
                "unspecified"
              ]
            },
            "office_location": {
              "type": "string",
              "maxLength": 80
            },
            "evidence": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "basis": {
              "enum": [
                "explicit",
                "implied"
              ]
            }
          }
        },
        "working_language": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "evidence"
          ],
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "english",
                "portuguese_with_english",
                "portuguese_only",
                "other_language_required",
                "unspecified"
              ]
            },
            "evidence": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "basis": {
              "enum": [
                "explicit",
                "implied"
              ]
            }
          }
        },
        "function_core": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "evidence"
          ],
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "analytics_for_decisions",
                "analytics_reporting",
                "solo_analysis",
                "product_without_analytics",
                "non_analytics",
                "unspecified"
              ]
            },
            "evidence": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "basis": {
              "enum": [
                "explicit",
                "implied"
              ]
            }
          }
        },
        "domain_fit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "industry",
            "requirement",
            "evidence"
          ],
          "properties": {
            "industry": {
              "type": "string",
              "enum": [
                "marketplace_classifieds",
                "ecommerce_retail",
                "mobility",
                "fintech",
                "saas_b2b",
                "consumer_apps",
                "gaming_betting",
                "healthtech",
                "pharma_biotech",
                "cybersecurity",
                "hardware_iot",
                "consulting_outsourcing",
                "public_sector_education",
                "other"
              ]
            },
            "requirement": {
              "type": "string",
              "enum": [
                "none",
                "preferred",
                "required"
              ]
            },
            "required_domain": {
              "enum": [
                "marketplace_classifieds",
                "ecommerce_retail",
                "mobility",
                "fintech",
                "saas_b2b",
                "consumer_apps",
                "gaming_betting",
                "healthtech",
                "pharma_biotech",
                "cybersecurity",
                "hardware_iot",
                "consulting_outsourcing",
                "public_sector_education",
                "other",
                null
              ]
            },
            "domain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "evidence": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "basis": {
              "enum": [
                "explicit",
                "implied"
              ]
            }
          },
          "if": {
            "required": [
              "requirement"
            ],
            "properties": {
              "requirement": {
                "enum": [
                  "preferred",
                  "required"
                ]
              }
            }
          },
          "then": {
            "required": [
              "required_domain"
            ],
            "properties": {
              "required_domain": {
                "enum": [
                  "marketplace_classifieds",
                  "ecommerce_retail",
                  "mobility",
                  "fintech",
                  "saas_b2b",
                  "consumer_apps",
                  "gaming_betting",
                  "healthtech",
                  "pharma_biotech",
                  "cybersecurity",
                  "hardware_iot",
                  "consulting_outsourcing",
                  "public_sector_education",
                  "other"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "required_domain": {
                "type": "null"
              }
            }
          }
        },
        "preferred_focus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values",
            "evidence"
          ],
          "properties": {
            "values": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "pricing_monetization",
                  "experimentation_causal",
                  "unit_economics_pnl_finance",
                  "marketplace_economics"
                ]
              }
            },
            "evidence": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "basis": {
              "enum": [
                "explicit",
                "implied"
              ]
            }
          }
        }
      }
    },
    "rules_relevance": {
      "enum": [
        0,
        1,
        2,
        3,
        null
      ]
    },
    "llm_relevance": {
      "enum": [
        0,
        1,
        2,
        3,
        null
      ]
    },
    "llm_relevance_stale": {
      "type": "boolean"
    },
    "relevance_by_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "llm": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "rules": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "max": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "min": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        null
      ]
    },
    "escalated": {
      "type": "boolean"
    },
    "escalation_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "p2_candidate": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "decision": {
      "enum": [
        "pass",
        "review",
        "reject",
        null
      ]
    },
    "tier": {
      "enum": [
        "A",
        "B",
        "C",
        null
      ]
    },
    "fit_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "model"
        ]
      }
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
