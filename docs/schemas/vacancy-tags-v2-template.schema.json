            "quote": {
              "type": "string"
            },
            "country": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "employment_type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "quote"
          ],
          "properties": {
            "value": {
              "type": "string",
