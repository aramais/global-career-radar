              "type": "string"
            }
          }
        },
        "decision_influence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "quote"
          ],
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "duty",
                "skill_only",
                "explicitly_absent",
