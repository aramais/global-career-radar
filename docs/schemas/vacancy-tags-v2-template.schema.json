{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vacancy-tags-v2 human template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_outcome",
    "job_uid",
    "labeled_at",
    "method",
    "notes",
    "relevance",
    "role_label",
    "source_hash",
    "tags",
    "text_version"
  ],
  "properties": {
    "schema": {
      "const": "vacancy-tags-v2"
    },
    "job_uid": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text_version": {
      "type": "string",
      "minLength": 1
    },
    "labeled_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "enum": [
        "blind",
        "assisted",
        null
      ]
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hiring_geography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "quote"
          ],
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "brazil_explicit",
                "includes_brazil_region",
                "excludes_brazil",
                "restricted_elsewhere",
                "unspecified"
              ]
            },
            "quote": {
              "type": "string"
            }
          }
        },
        "work_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "quote"
          ],
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "remote",
                "remote_or_hybrid",
                "hybrid",
                "onsite",
                "unspecified"
              ]
            },
            "quote": {
              "type": "string"
            },
            "office_location": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "working_language": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "quote"
          ],
          "properties": {
            "value": {
              "type": "string",
              "enum": [
