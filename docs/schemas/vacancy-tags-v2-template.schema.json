              "type": "string"
            }
          }
        },
        "people_interaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "quote"
          ],
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "duty",
                "skill_only",
